# ---- Gateway ----
GATEWAY_PORT=8081
GATEWAY_TIMEOUT_SECONDS=15

# ---- Item service (Service B) ----
ITEM_SERVICE_PORT=50051
ITEM_DB_NAME=item_db
ITEM_DB_USER=item_user
ITEM_DB_PASSWORD=item_pass

# ---- Claim service (Service A) ----
CLAIM_SERVICE_PORT=50052
CLAIM_DB_NAME=claim_db
CLAIM_DB_USER=claim_user
CLAIM_DB_PASSWORD=claim_pass

# ---- Resilience settings for Claim -> Item calls ----
ITEM_CALL_TIMEOUT_MS=2000
ITEM_MAX_ATTEMPTS=3
ITEM_BACKOFF_MS=200
CB_FAILURE_THRESHOLD=3
CB_OPEN_SECONDS=10
