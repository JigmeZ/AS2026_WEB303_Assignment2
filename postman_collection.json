    {
      "name": "4. Resilience demo (run `docker stop item-service` first)",
      "item": [
        {
          "name": "Create claim while Item service is DOWN -> 503",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/claims",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": {{item_id}},\n  \"claimant_name\": \"Pema Wangmo\",\n  \"claimant_email\": \"pema@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send this 4-5 times: first calls show retries, later calls fail instantly because the circuit breaker is open."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 503\", () => pm.response.to.have.status(503));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get claim while Item service is DOWN -> 200 with fallback item_name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
